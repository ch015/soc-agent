# Local HTTP server; compose exposes the same port on the host.
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://soc:soc-local@127.0.0.1:55433/soc_agent
REDIS_URL=redis://127.0.0.1:56380

# v2: SIEM BE HTTP API (no sibling repository or source mount is required).
SIEM_BE_BASE_URL=http://127.0.0.1:8080
SIEM_BE_SERVICE_TOKEN=
# nunchi-core REST API (default), or a portable POST /tools/<name> adapter.
SOC_DATA_CONNECTOR=nunchi-core
# Optional comma-separated supported tool names; omitted means all eight tools.
# SOC_TOOL_CAPABILITIES=get_signal,get_event_fields,search_events
ANTHROPIC_API_KEY=
# Native tool-use model; override if needed for your account.
# SOC_LLM_MODEL=claude-haiku-4-5-20251001
SLACK_BOT_TOKEN=
SLACK_CHANNEL_SOC=#soc-alerts
SLACK_CHANNEL_CRITICAL=#soc-critical
SLACK_CHANNEL_HIGH=#soc-high

# v1: trusted Ed25519 public key from the snapshot/redaction producer.
AUTH_MODE=api_key
DEFAULT_MODEL=opus
DEFAULT_REVIEW_MODEL=sonnet
SOC_REDACTION_ISSUER=
SOC_REDACTION_KEY_ID=
SOC_REDACTION_PUBLIC_KEY_FILE=
# SOC_HANDLER_VERSION=v1  # default v2, preparedSnapshot jobs dispatch to v1 automatically

# Optional result delivery and playbook connectors.
PAGERDUTY_ROUTING_KEY=
INCIDENT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SOC

# Optional shared state for local v1 missions. File state is the default.
# NUNCHI_STATE_BACKEND=postgres
# NUNCHI_DATABASE_URL=postgresql://soc:soc-local@127.0.0.1:55433/soc_agent
# NUNCHI_ARTIFACT_ROOT=/absolute/path/to/artifacts
# NUNCHI_SHARED_ENGAGEMENT_ROOT=/absolute/path/to/engagements
